# Frontend site URL. Used for canonical tags, OG URLs, sitemap, and structured data.
SITE_URL=https://gonkarouter.io

# Backend gateway origin (no trailing slash).
API_BASE=https://api.gonkarouter.io

# Google Search Console HTML-tag verification token.
# Get it from: Search Console → Settings → Ownership verification → HTML tag.
# Example (do NOT commit real tokens): weP2-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SITE_VERIFICATION=

# Google Sign-In OAuth client ID (public, safe to expose). Create at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application), with Authorized JavaScript origins set to the frontend
# domains. Empty → the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (public) for the email-login human check.
# Create at Cloudflare → Turnstile. Empty → the widget is skipped.
TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (public, appears in page source anyway).
# Get it from: Analytics → Admin → Data streams → your web stream (G-XXXXXXXXXX).
#
# Empty → no analytics script is loaded at all. Leave it empty locally: a real
# ID here would send your own dev browsing into the production property and
# skew the reports.
#
# Read at BUILD time (baked into the bundle), so set it before `npm run build`.
# To override an already-built server instead, pass the runtime form:
#   NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# === Per-user rate limits (gonka router only) ===
# Applied before the request reaches upstream, so a rejection costs nothing
# beyond the gateway. Standard X-RateLimit-* headers and Retry-After are
# emitted so SDKs back off instead of hammering. 0 disables that dimension.
#
# CHAT_USER_RPM         requests per minute (fixed window)
# CHAT_USER_RPD         requests per day    (fixed window)
# CHAT_USER_CONCURRENCY simultaneous in-flight requests per user
#
# Sizing note: sustainable throughput is roughly CONCURRENCY / avg-latency, so
# with 8 concurrent and ~30s responses a user tops out near 16 RPM organically.
# A much higher RPM number only bites when requests are failing fast — which is
# exactly the retry storm it exists to stop.
CHAT_USER_RPM=0
CHAT_USER_RPD=0
CHAT_USER_CONCURRENCY=8
