# Frontend site URL. Used for canonical tags, OG URLs, sitemap, and structured data.
SITE_URL=https://gonkarouter.io

# Backend gateway origin (no trailing slash).
API_BASE=https://api.gonkascan.com

# Google Search Console HTML-tag verification token.
# Get it from: Search Console → Settings → Ownership verification → HTML tag.
# Example (do NOT commit real tokens): weP2-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SITE_VERIFICATION=

# Google Sign-In OAuth client ID (public, safe to expose). Create at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application), with Authorized JavaScript origins set to the frontend
# domains. Empty → the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (public) for the email-login human check.
# Create at Cloudflare → Turnstile. Empty → the widget is skipped.
TURNSTILE_SITE_KEY=
