# Frontend site URL. Used for canonical tags, OG URLs, sitemap, and structured data.
SITE_URL=https://gonkarouter.io

# Backend gateway origin (no trailing slash).
API_BASE=https://api.gonkascan.com

# Google Search Console HTML-tag verification token.
# Get it from: Search Console → Settings → Ownership verification → HTML tag.
# Example (do NOT commit real tokens): weP2-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SITE_VERIFICATION=
